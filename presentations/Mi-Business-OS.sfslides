        {"id": "s10_card1_desc", "type": "text", "content": "Qui\u00e9n soy, mi negocio, avatar,\nposicionamiento, competencia,\nestrategia de contenido.", "x": 200, "y": 290, "width": 440, "height": 100, "font_size": 18, "color": "#888888", "line_spacing": 1.4},
        {"id": "s10_card2_bg", "type": "shape", "shape": "rounded_rect", "x": 700, "y": 220, "width": 540, "height": 200, "fill": "#1a1a1a", "corner_radius": 16, "stroke": {"color": "#8C27F1", "width": 1}, "shadow": {"color": "#8C27F1", "blur": 15, "offset_x": 0, "offset_y": 0}},
        {"id": "s10_card2_icon_bg", "type": "shape", "shape": "ellipse", "x": 730, "y": 240, "width": 36, "height": 36, "fill": "#8C27F1"},
        {"id": "s10_card2_icon", "type": "text", "content": "\ud83d\udcca", "x": 730, "y": 251, "width": 36, "height": 18, "font_size": 18, "align": "center"},
