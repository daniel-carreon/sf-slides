      "elements": [
        {"id": "s1_label", "type": "text", "content": "BUSINESS LAND | TALENT LAND 2026", "x": 160, "y": 120, "width": 800, "height": 30, "font_size": 14, "color": "#f69f02", "bold": true, "letter_spacing": 4},
        {"id": "s1_title", "type": "text", "content": "Mi Business OS", "x": 160, "y": 240, "width": 900, "height": 200, "font_size": 96, "color": "#ffffff", "bold": true, "line_spacing": 1.1},
        {"id": "s1_sub", "type": "text", "content": "Cómo un sistema de IA opera mi negocio.", "x": 160, "y": 460, "width": 800, "height": 50, "font_size": 26, "color": "#BBBBBB"},
        {"id": "s1_line", "type": "line", "x": 160, "y": 560, "width": 300, "height": 0, "x1": 160, "y1": 560, "x2": 460, "y2": 560, "color": "#f69f02", "line_width": 2},
        {"id": "s1_speaker", "type": "text", "content": "Daniel Carreon", "x": 160, "y": 590, "width": 300, "height": 30, "font_size": 18, "color": "#ffffff", "bold": true},
        {"id": "s1_org", "type": "text", "content": "SaaS Factory Community", "x": 160, "y": 625, "width": 400, "height": 30, "font_size": 16, "color": "#f69f02"},
        {"id": "s1_arc1", "type": "shape", "shape": "ellipse", "x": 1100, "y": 100, "width": 700, "height": 700, "fill": null, "stroke": {"color": "#f69f02", "width": 1}, "opacity": 0.12},
        {"id": "s1_arc2", "type": "shape", "shape": "ellipse", "x": 1170, "y": 170, "width": 560, "height": 560, "fill": null, "stroke": {"color": "#8C27F1", "width": 1}, "opacity": 0.10},
        {"id": "s1_arc3", "type": "shape", "shape": "ellipse", "x": 1240, "y": 240, "width": 420, "height": 420, "fill": null, "stroke": {"color": "#f69f02", "width": 1}, "opacity": 0.07},
        {"id": "s1_term_bg", "type": "shape", "shape": "rounded_rect", "x": 1150, "y": 500, "width": 650, "height": 380, "fill": "#111111", "corner_radius": 12, "stroke": {"color": "#333333", "width": 1}},
        {"id": "s1_term_bar", "type": "shape", "shape": "rounded_rect", "x": 1150, "y": 500, "width": 650, "height": 32, "fill": "#1a1a1a", "corner_radius": 0},
        {"id": "s1_term_dot1", "type": "shape", "shape": "ellipse", "x": 1166, "y": 510, "width": 12, "height": 12, "fill": "#FF3333"},
        {"id": "s1_term_dot2", "type": "shape", "shape": "ellipse", "x": 1186, "y": 510, "width": 12, "height": 12, "fill": "#FFB800"},
        {"id": "s1_term_dot3", "type": "shape", "shape": "ellipse", "x": 1206, "y": 510, "width": 12, "height": 12, "fill": "#00CC66"},
        {"id": "s1_code1", "type": "text", "content": "class BusinessOS:", "x": 1170, "y": 548, "width": 600, "height": 28, "font_size": 15, "color": "#f69f02", "font_family": "Menlo, monospace"},
        {"id": "s1_code2", "type": "text", "content": "    brain = \"CLAUDE.md\"  # 1,300 lines", "x": 1170, "y": 576, "width": 600, "height": 28, "font_size": 15, "color": "#DDDDDD", "font_family": "Menlo, monospace"},
        {"id": "s1_code3", "type": "text", "content": "    skills = 18", "x": 1170, "y": 604, "width": 600, "height": 28, "font_size": 15, "color": "#DDDDDD", "font_family": "Menlo, monospace"},
        {"id": "s1_code4", "type": "text", "content": "    cron_jobs = 20", "x": 1170, "y": 632, "width": 600, "height": 28, "font_size": 15, "color": "#8C27F1", "font_family": "Menlo, monospace"},
        {"id": "s1_code5", "type": "text", "content": "    ml_models = 2", "x": 1170, "y": 660, "width": 600, "height": 28, "font_size": 15, "color": "#00CC66", "font_family": "Menlo, monospace"},
        {"id": "s1_code6", "type": "text", "content": "    agents = [\"Trinity\",\"Sensei\",\"Levy\"]", "x": 1170, "y": 688, "width": 600, "height": 28, "font_size": 15, "color": "#00CC66", "font_family": "Menlo, monospace"},
        {"id": "s1_code7", "type": "text", "content": "    revenue = \"$72,000+\"", "x": 1170, "y": 716, "width": 600, "height": 28, "font_size": 15, "color": "#f69f02", "font_family": "Menlo, monospace"},
        {"id": "s1_bokeh1", "type": "shape", "shape": "ellipse", "x": 300, "y": 50, "width": 80, "height": 80, "fill": "#f69f02", "opacity": 0.06, "shadow": {"color": "#f69f02", "blur": 30, "offset_x": 0, "offset_y": 0}},
        {"id": "s1_bokeh2", "type": "shape", "shape": "ellipse", "x": 900, "y": 30, "width": 120, "height": 120, "fill": "#f69f02", "opacity": 0.04},
        {"id": "s1_footer_left", "type": "text", "content": "DANIEL CARREON | SAAS FACTORY", "x": 120, "y": 1020, "width": 600, "height": 24, "font_size": 11, "color": "#555555"},
        {"id": "s1_footer_right", "type": "text", "content": "BUSINESS LAND 2026", "x": 1200, "y": 1020, "width": 600, "height": 24, "font_size": 11, "color": "#f69f02", "align": "right"}
      ],
      "notes": "COVER. Saludo rapido. 'Tengo 25 anos, un negocio que ha procesado mas de $72K dolares, 700 personas pagandome cada mes, y cero empleados. Hoy les voy a mostrar el sistema que lo hace posible.'"
    },
    {
      "id": 2,
