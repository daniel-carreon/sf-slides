        {"id": "s14_bottom", "type": "text", "content": "508 de 626 miembros han usado los agentes. 81.2% de adopci\u00f3n.", "x": 160, "y": 620, "width": 1600, "height": 40, "font_size": 22, "color": "#888888", "align": "center"},
